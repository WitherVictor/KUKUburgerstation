/obj/item/clothing/special/legion_soul
	name = "军团之魂"
	desc = "献给害怕死亡的人。"
	desc_extended = "强大的遗物，可防止使用者死亡时丢失装备。仅可使用一次，而且必须佩戴在特殊槽中才生效。"

/obj/item/clothing/special/soulstone
	name = "灵魂石"
	desc = "用起来似乎不太安全……最坏能怎样呢？"
	desc_extended = "备受追捧的结晶血液碎片，能储存不幸受害者的灵魂。\
	空灵魂石可佩戴在特殊槽中，给你一次保住物品和装备的额外机会，代价是你得以一半生命值再次保护自己。\
	注意：若你在5分钟内再次死亡，所有灵魂绑定物品也会一同消亡。"
	var/active = 0

/obj/item/clothing/special/purple_mass
	name = "黑曜石团块"
	desc = "来自天界的礼物。"
	desc_extended = "一团极其罕见的紫色物质，在流星雨中落到了平原上。\
	可以激活一次，将你的声音传遍整片平原，随后便会毁坏；也可以佩戴着，让你的声音稍微响亮一些。"

/obj/item/clothing/special/burning_eyes
	name = "燃烧之眼"
	desc = "别试着拿它们替换你的眼睛。"
	desc_extended = "恶魔和律师钟爱的幸运符。佩戴时可以准确看出他人的善恶值，也包括你自己。"

/obj/item/clothing/special/silver_coin
	name = "银币"
	desc = "幸运符。"
	desc_extended = "一枚罕见而闪亮的硬币，保存完好。佩戴在特殊槽中时，被动增加10点幸运。"

/obj/item/clothing/special/gold_coin
	name = "金币"
	desc = "幸运符。"
	desc_extended = "一枚极其罕见而闪亮的硬币，保存完好。佩戴在特殊槽中时，被动增加25点幸运，但异常脆弱，会在死亡时破碎。"

/obj/item/clothing/special/pocket_watch
	name = "怀表"
	desc = "秒针似乎走得有点慢。"
	desc_extended = "古老而精美的计时装置，表面镀有优质金合金。装备在特殊槽中时，每天可激活一次，将你的眩晕时间清零。"

/obj/item/clothing/special/ban_hammer
	name = "封禁之锤"
	desc = "没错，它真的能把你封禁。"
	desc_extended = "一把拥有强大力量的橙色塑料充气锤。\
	虽然不能放逐别人，却可以激活，将你安全地放逐回上次使用的许愿机，同时禁止你在15分钟内离开。"

/obj/item/clothing/special/honk
	name = "自行车喇叭"
	desc = "叭。"
	desc_extended = "戴上后除了叭叭响，什么都不会干。你他妈从哪儿找到的？怎么还没把它扔进岩浆？你他妈有什么毛病？"

/obj/item/clothing/special/potato_battery
	name = "土豆电池"
	desc = "比普斯基以前靠它供电。愿他的灵魂安息。"
	desc_extended = "一次性用品，召唤一台比普斯基无人机，追捕并击晕善恶值低的人，直到无人机被摧毁或电量耗尽。"
